# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it.
#
# Expo SDK 49+ loads .env files automatically.
# Variables prefixed EXPO_PUBLIC_ are bundled into the JS bundle
# and accessible as process.env.EXPO_PUBLIC_* in app code.
# Variables without that prefix are build-time only (app.config.js).

# Base URL of the Punji Bandhu backend (no trailing slash).
# Used by instruments.service.ts (instrument list) and stream.service.ts (SSE feed).
EXPO_PUBLIC_API_BASE_URL=https://your-backend-host.example.com
